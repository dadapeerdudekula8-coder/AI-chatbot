# ============================================================
# SupportAI — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/supportai?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-char-string"
AUTH_URL="http://localhost:3000"

# --- Google Gemini AI ---
GEMINI_API_KEY="your-gemini-api-key-here"
# Model names: gemini-1.5-flash (fast/cheap), gemini-1.5-pro (capable)
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# --- Optional: OpenAI (alternative provider) ---
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# --- File Storage ---
# "local" uses ./uploads directory in dev; "vercel-blob" uses Vercel Blob in prod
STORAGE_ADAPTER="local"
LOCAL_UPLOAD_DIR="./uploads"
# BLOB_READ_WRITE_TOKEN="vercel-blob-token"  # For Vercel Blob

# --- App Settings ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SupportAI"

# --- Rate Limiting ---
# "memory" (dev) or "redis" (prod)
RATE_LIMIT_ADAPTER="memory"
# UPSTASH_REDIS_REST_URL="..."
# UPSTASH_REDIS_REST_TOKEN="..."

# --- Email (optional, for notifications) ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your@email.com"
# SMTP_PASS="app-password"
# SMTP_FROM="SupportAI <noreply@yourdomain.com>"

# --- Admin Seed ---
# Used only by prisma/seed.ts — never expose in production
SEED_ADMIN_EMAIL="admin@supportai.dev"
SEED_ADMIN_PASSWORD="Admin@123456"
