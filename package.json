{
  "name": "supportai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test tests/unit.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e.test.ts",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "node node_modules/.bin/prisma generate",
    "db:push": "node node_modules/.bin/prisma db push",
    "db:migrate": "node node_modules/.bin/prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node node_modules/.bin/prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.postgresql.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^6.0.0",
    "@prisma/client": "^5.22.0",
    "@types/three": "^0.186.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "next": "14.2.29",
    "next-auth": "^5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "prisma": "^5.22.0",
    "rate-limiter-flexible": "^11.2.3",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.29",
    "playwright": "^1.64.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
